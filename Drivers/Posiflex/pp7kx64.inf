;
;	Printer Installation File
;
;	 List of supported printers, manufacturers
;

[Version]
Signature="$Windows NT$"
Provider=%PF%
LayoutFile=ntprint.inf
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
DriverVer=10/19/2023,1.0.6.m
CatalogFile.NTAMD64=pp7x64.cat

;
; Manufacturer section.
;
; This section lists all of the manufacturers
; that we will display in the Dialog box
;

[Manufacturer]
"Posiflex Inc." = Posiflex, NTamd64

;
; Model Specifications Section
;

[Posiflex.NTamd64]
;"Posiflex PP7000 Partial Cut v3" = pp7epc,LPTENUM\POSIFLEXPP700099A6,PP-7000
;"Posiflex PP7000 No Cut v3" = pp7enc,LPTENUM\POSIFLEXPP700099A6,PP-7000
