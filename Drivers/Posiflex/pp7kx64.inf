;
; Installer section(s) referenced above.
;

[pp7eqc]
CopyFiles=@PP7kres.Dll,@pp7eqc.GPD,@pp7kuxi.ini,@pp9ttfsub.gpd,OEM_BIDIMON
CopyFiles=pp7kuni
CopyFiles=pp7kui
CopyFiles=pp9ttfsub.GPD
DataSection=OEM_BIDI_DATA
DataFile=pp7eqc.GPD
Include=NTPRINT.INF
Needs=UNIDRV_BIDI.OEM

;CopyFiles=OEM_BIDIMON
;Needs=UNIDRV.OEM
;DataSection=UNIDRV_DATA

