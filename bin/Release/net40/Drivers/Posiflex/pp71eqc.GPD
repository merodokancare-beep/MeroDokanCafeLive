*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "1.0"
*GPDFileName: "pp7eqc.GPD"
*ModelName: "Posiflex 202-80 Printer"
*MasterUnits: PAIR(202, 202)
*ResourceDLL: "pp7kres.Dll"
*PrinterType: SERIAL

*%-----------------------------haiko add
*Include: "pp9ttfsub.gpd"
*%-----------------------------

*Feature: Posiflex0
{
    *Name: "Version"
    *FeatureType: PRINTER_PROPERTY
