*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 266
        *OptionID: 266
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option3
    *Option: Option2
    {
		*Name: "101 x 101 " =DOTS_PER_INCH
		*DPI: PAIR(101, 101)
		*TextDPI: PAIR(101, 101)
		*PinsPerLogPass: 24
		*PinsPerPhysPass: 24
		*%EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
		*SpotDiameter: 120
		*%Command: CmdSendBlockData { *Cmd : "<1B>J<001D>v03" }
		*Command: CmdSendBlockData
		{
			*CallbackID: 71
			*Params: LIST(CurrentFontID,CursorOriginX,CursorOriginY)
		}
	}
    *Option: Option3
    {
		*Name: "202 x 202 " =DOTS_PER_INCH
		*DPI: PAIR(202, 202)
		*TextDPI: PAIR(202, 202)
		*PinsPerLogPass: 24
		*PinsPerPhysPass: 24
		*%EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
		*SpotDiameter: 140
		*%Command: CmdSendBlockData { *Cmd : "<1B>J<001D>v00" }
		*Command: CmdSendBlockData
		{
			*CallbackID: 70
			*Params: LIST(CurrentFontID,CursorOriginX,CursorOriginY)
		}
    }
}
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option4
    *Option: Option1
    {
		*rcNameID: 258
		*OptionID: 258
		*PageDimensions: PAIR(640, 1212)
		*PrintableArea: PAIR(608, 1212)
		*PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option3
    {
		*rcNameID: 260
		*OptionID: 260
		*PageDimensions: PAIR(640, 2222)
		*PrintableArea: PAIR(608, 2222)
		*PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option4
    {
		*rcNameID: 261
		*OptionID: 261
		*PageDimensions: PAIR(640, 25856)
		*PrintableArea: PAIR(608, 25856)
		*PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option5
    {
		*rcNameID: 269
		*OptionID: 269
		*PageDimensions: PAIR( 640, 646400)
		*PrintableArea: PAIR( 608, 646400)
		*PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option6
    {
		*rcNameID: 271
		*OptionID: 271
		*PageDimensions: PAIR(640, 4444)
		*PrintableArea: PAIR(608, 4444)
		*PrintableOrigin: PAIR(0, 0)
    }
}
*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_AUTO
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
