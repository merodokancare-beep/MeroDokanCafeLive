<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============ ACTIVE CONFIGURATION FOR WINDOWS 7 / WIN 10 / WIN 11 ============
       Targeting .NET Framework 4.0 for compatibility with Windows 7 (RTM/SP1), 10, and 11.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MeroDokanCafe</AssemblyName>
    <RootNamespace>MeroDokan</RootNamespace>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Allows building on machines without the VS ".NET desktop development" workload -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="dbconfig.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MeroDokanCafe_Database_Setup.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Setup_Database.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Setup_Database.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Drivers\**" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Data" />
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
